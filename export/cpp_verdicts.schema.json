{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sevens-Dev/px4-reqcheck/export/cpp_verdicts.schema.json",
  "title": "PX4 C++ checker verdict contract",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["log_id", "req_id", "status", "metric_value", "reason"],
    "properties": {
      "log_id": {"type": "string", "minLength": 1},
      "req_id": {"type": "string", "minLength": 1},
      "status": {"enum": ["pass", "fail", "not_evaluable"]},
      "metric_value": {"type": ["number", "null"]},
      "reason": {"type": ["string", "null"]}
    }
  }
}
